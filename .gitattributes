# .gitattributes — Crowd Decoder
# THE PARTH SHAH | Red & White Skill Education
# ─────────────────────────────────────────────────────────────

# Same line endings on Mac, Windows and Linux
* text=auto

# UL_PR1.html is exported from UL_PR1.ipynb — keep it out of GitHub's
# language bar so the repo shows up as a Jupyter Notebook project
*.html linguist-generated

# Keep the Kaggle CSV byte-for-byte exactly as downloaded
*.csv -text

# Images are binary — never diff or convert them
*.png binary
